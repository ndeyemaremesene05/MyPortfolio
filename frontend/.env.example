# Copiez ce fichier en .env.production et remplacez les valeurs avant "npm run build".

# Adresse publique du site, SANS slash final (sert au SEO : canonical, Open Graph, sitemap)
VITE_SITE_URL=https://votre-portfolio.vercel.app

# Adresse de l'API Laravel.
#   /api                          -> Laravel sert aussi le site (même domaine)
#   https://api.mondomaine.com/api -> API sur un autre domaine (pensez au CORS côté Laravel)
#   (vide)                        -> pas d'API : le site utilise le contenu intégré, le formulaire propose l'email
VITE_API_URL=/api
